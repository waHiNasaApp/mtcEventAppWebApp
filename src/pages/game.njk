<script type="module">
  function switchLeaderboard(type) {
    if (type == "points") {
      // Switch leaderboard to "By Points"
      byPointsButton.classList.add("btn-selected")
      byPointsContainer.classList.remove("hidden")
      byUsersButton.classList.remove("btn-selected")
      byUsersContainer.classList.add("hidden")
    } else {
      // Switch leaderboard to "By Users"
      byPointsButton.classList.remove("btn-selected")
      byPointsContainer.classList.add("hidden")
      byUsersButton.classList.add("btn-selected")
      byUsersContainer.classList.remove("hidden")
    }
  }

  async function loadLeaderboard() {
    try {
      // Call the Firebase function with n=10
      const result = await getLeaderboards({ n: 10 })
      const { topByPoints, topByUsersMet } = result.data

      // Clear loading states
      byPointsContainer.innerHTML = ""
      byUsersContainer.innerHTML = ""

      // Render Top by Points
      topByPoints.forEach((user, index) => {
        const userElement = document.createElement("div")
        userElement.className = "leaderboard-user-row"
        userElement.innerHTML = `
                <div class="flex items-center gap-4">
                    <div class="leaderboard-rank">
                        ${index + 1}
                    </div>
                    <div class="font-semibold">
                        ${
                          user.fullName
                        } - <span class="font-normal text-sm">ID: ${
          user.scoutingId
        }</span>
                    </div>
                </div>
                <div class="font-bold">
                    ${
                      user.currentPoints
                    } <span class="text-xs font-normal">pts</span>
                </div>
            `
        byPointsContainer.appendChild(userElement)
      })

      // Render Top by Users Met
      topByUsersMet.forEach((user, index) => {
        const userElement = document.createElement("div")
        userElement.className = "leaderboard-user-row"
        userElement.innerHTML = `
                <div class="flex items-center gap-4">
                    <div class="leaderboard-rank">
                        ${index + 1}
                    </div>
                    <div class="font-semibold">
                        ${
                          user.fullName
                        } - <span class="font-normal text-sm">ID: ${
          user.scoutingId
        }</span>
                    </div>
                </div>
                <div class="font-bold">
                    ${
                      user.numUsersMet
                    } <span class="text-xs font-normal">connections</span>
                </div>
            `
        byUsersContainer.appendChild(userElement)
      })
    } catch (error) {
      console.error("Failed to load leaderboards:", error)
      byPointsContainer.innerHTML = "<p>Error loading leaderboard.</p>"
      byUsersContainer.innerHTML = "<p>Error loading leaderboard.</p>"
    }
  }

  /**
   * Searches the /users/ Firestore collection and renders a results grid.
   *
   * @param {string} type - The field to search ("fullName", "scoutingId", or "emailLower")
   */
  async function searchUsers(type) {
    // Clear the existing container contents
    searchResultsContainer.innerHTML = ""

    if (!searchInputElement) {
      console.error("Search input element #user-search-input not found.")
      return
    }

    const searchValue = searchInputElement.value.trim().toLowerCase()

    // Prevent querying with an empty string if the user accidentally clicks search
    if (!searchValue) {
      searchResultsContainer.innerHTML = "<p>Please enter a search term.</p>"
      return
    }

    try {
      // Build and execute the Firestore query
      const usersRef = collection(db, "users")
      const q = query(
        usersRef,
        where(type, ">=", searchValue),
        where(type, "<=", searchValue + "\uf8ff")
      )
      const querySnapshot = await getDocs(q)

      if (querySnapshot.empty) {
        searchResultsContainer.innerHTML = "<p>No users found.</p>"
        return
      }

      // Set up the table/grid structure
      const table = document.createElement("table")
      table.style.width = "100%"
      table.innerHTML = `
      <thead>
        <tr>
          <th class="text-left">Name</th>
          <th class="text-left">Scouting ID</th>
          <th class="text-left">Current<br>Points</th>
          <th class="text-left">Users<br>Met</th>
          <th class="text-left">Worth<br>Points</th>
          <th class="text-left"></th>
        </tr>
      </thead>
      <tbody></tbody>
    `

      const tbody = table.querySelector("tbody")

      // Populate the table with user documents
      querySnapshot.forEach((doc) => {
        const user = doc.data()

        // Store the document ID in the user object
        user.id = doc.id

        const fullName = `${user.fullName}`

        const tr = document.createElement("tr")
        tr.innerHTML = `
        <td>${fullName}</td>
        <td>${user.scoutingId || ""}</td>
        <td>${user.currentPoints || 0}</td>
        <td>${user.numUsersMet || 0}</td>
        <td>${user.worthPoints || 0}</td>
        <td class="action-cell"></td>
      `

        // Create modify buttons
        const modifyBtn = document.createElement("button")
        modifyBtn.className = "btn btn-alternate m-1"
        modifyBtn.textContent = "Modify"
        modifyBtn.onclick = () => startModifyUser(doc)

        tr.querySelector(".action-cell").appendChild(modifyBtn)
        tbody.appendChild(tr)
      })

      // Append the completed grid to the DOM
      searchResultsContainer.appendChild(table)
    } catch (error) {
      console.error("Error fetching users:", error)
      searchResultsContainer.innerHTML =
        "<p>Error loading users. Check console for details.</p>"
    }
  }

  /**
   *  Loads the user's data into the modify fields
   *
   * @param {Firestore Doc} doc The doc of the user to load
   */
  function startModifyUser(doc) {
    const user = doc.data()

    userIdInput.value = doc.id
    userNameInput.value = user.fullName
    userCurrentPointsInput.value = user.currentPoints
    userWorthPointsInput.value = user.worthPoints
    userWorthPointsCommentInput.value = user.userWorthPointsComment ?? ""
  }

  async function modifyUser() {
    // Get userId and docRef
    const userId = userIdInput.value
    const docRef = doc(db, "users", userId)

    try {
      await updateDoc(docRef, {
        fullName: userNameInput.value,
        currentPoints: Number(userCurrentPointsInput.value),
        worthPoints: Number(userWorthPointsInput.value),
        userWorthPointsComment: userWorthPointsCommentInput.value,
      })

      //FIXME: add recursion to modify from all users who met this user

      showToast("User modified successfully!")

      // Reload data
      resetAndReload()
    } catch (error) {
      showToast("Error updating user:", error)
    }
  }

  async function deleteUser() {
    const isConfirmed = window.confirm(
      "Are you sure you want to delete this user? This action cannot be undone."
    )
    if (!isConfirmed) {
      return
    }

    // Get userId and docRef
    const userId = userIdInput.value
    const docRef = doc(db, "users", userId)

    try {
      await deleteDoc(docRef)
      //FIXME: add recursion to delete from all users who met this user

      showToast("User deleted successfully!")

      // Reload data
      resetAndReload()
    } catch (error) {
      showToast("Error deleting user:", error)
    }
  }

  async function resetAndReload() {
    // Clear input fields
    userIdInput.value = ""
    userNameInput.value = ""
    userCurrentPointsInput.value = ""
    userWorthPointsInput.value = ""
    userWorthPointsCommentInput.value = ""

    // Reset search
    searchResultsContainer.innerHTML = `<p class="text-scouting-pale-grey italic">Start a search to view users...</p>`

    // Reload leaderboard
    await loadLeaderboard()
  }

  /**
   * Displays a temporary toast notification to the user.
   * @param {string} message - The message to display in the toast.
   */
  function showToast(message) {
    const container = document.getElementById("toast-container")
    if (!container) return

    const toast = document.createElement("div")
    toast.className = "toast-message opacity-0"
    toast.innerText = message

    container.appendChild(toast)

    setTimeout(() => {
      toast.classList.remove("opacity-0")
      toast.classList.add("opacity-100")
    }, 10)

    setTimeout(() => {
      toast.classList.remove("opacity-100")
      toast.classList.add("opacity-0")
      setTimeout(() => toast.remove(), 300)
    }, 3000)
  }

  /**
   * Waits for an element to appear in the DOM.
   * @param {string} selector - The CSS selector of the element to wait for.
   * @returns {Promise<Element>} A promise that resolves with the DOM element.
   */
  async function waitForElement(selector) {
    return new Promise((resolve) => {
      if (document.querySelector(selector)) {
        return resolve(document.querySelector(selector))
      }
      const observer = new MutationObserver((mutations) => {
        if (document.querySelector(selector)) {
          observer.disconnect()
          resolve(document.querySelector(selector))
        }
      })
      observer.observe(document.body, { childList: true, subtree: true })
    })
  }

  /**
   * Runs on initial load, waits for content to be loaded from firebase
   * Sets up event listeners
   */
  function createEventListeners() {
    document
      .getElementById("search-name-btn")
      .addEventListener("click", () => searchUsers("fullNameLower"))
    document
      .getElementById("search-scouting-id-btn")
      .addEventListener("click", () => searchUsers("scoutingId"))
    document
      .getElementById("search-email-btn")
      .addEventListener("click", () => searchUsers("emailLower"))

    document
      .getElementById("modify-user-btn")
      .addEventListener("click", () => modifyUser())
    document
      .getElementById("delete-user-btn")
      .addEventListener("click", () => deleteUser())

    byPointsButton.addEventListener("click", () => switchLeaderboard("points"))
    byUsersButton.addEventListener("click", () => switchLeaderboard("users"))

    searchInputElement.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        searchUsers("fullNameLower")
      }
    })
  }

  // Import Firebase modules
  import { initializeApp, getApp } from "firebase/app"
  import { getFunctions, httpsCallable } from "firebase/functions"
  import {
    getFirestore,
    doc,
    getDoc,
    updateDoc,
    deleteDoc,
    collection,
    query,
    where,
    getDocs,
  } from "firebase/firestore"

  // Initalize Firebase constants
  const app = getApp()
  const db = getFirestore(app)
  const functions = getFunctions(app)
  const getLeaderboards = httpsCallable(functions, "getLeaderboards")

  // Wait for DOM content to be loaded in
  await waitForElement(".columns-grid")

  // Set up DOM elements
  const userIdInput = document.getElementById("modify-user-id")
  const userNameInput = document.getElementById("modify-user-name")
  const userCurrentPointsInput = document.getElementById(
    "modify-user-current-points"
  )
  const userWorthPointsInput = document.getElementById(
    "modify-user-worth-points"
  )
  const userWorthPointsCommentInput = document.getElementById(
    "modify-user-worth-points-comment"
  )
  const searchResultsContainer = document.getElementById("user-search-list")
  const searchInputElement = document.getElementById("user-search-input")

  const byPointsContainer = document.getElementById("leaderboard-by-points")
  const byUsersContainer = document.getElementById("leaderboard-by-users")
  const byPointsButton = document.getElementById("leaderboard-by-points-btn")
  const byUsersButton = document.getElementById("leaderboard-by-users-btn")

  // Set up event listeners
  createEventListeners()

  // Load leaderboard
  await loadLeaderboard()
</script>

<div class="columns-grid">
  <!-- Left Column -->
  <div class="card-column">
    <!-- Card -->
    <div class="card-padded">
      <h2 class="item-title">User Search</h2>
      <div class="card-contents">
        <input
          id="user-search-input"
          type="text"
          placeholder="Search users..."
          class="input-text"
        />

        <div class="flex flex-wrap gap-2">
          <button id="search-name-btn" class="btn btn-alternate-blue">
            Search Name
          </button>
          <button id="search-scouting-id-btn" class="btn btn-alternate-blue">
            Search Scouting ID
          </button>
          <button id="search-email-btn" class="btn btn-alternate-blue">
            Search Email
          </button>
        </div>

        <div id="user-list">
          <div id="user-search-list">
            <p class="text-scouting-pale-grey italic">
              Start a search to view users...
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Card -->
    <div class="card-padded">
      <h2 class="item-title">Modify User</h2>
      <div class="card-contents">
        <div class="modify-user-div">
          <h3 class="modify-user-title">User ID</h3>
          <input
            id="modify-user-id"
            class="input-text bg-gray-200!"
            type="text"
            disabled
          />
        </div>
        <div class="modify-user-div">
          <h3 class="modify-user-title">Name</h3>
          <input id="modify-user-name" class="input-text" type="text" />
        </div>

        <div class="modify-user-div">
          <h3 class="modify-user-title">Current Points</h3>
          <input
            id="modify-user-current-points"
            class="input-text"
            type="number"
          />
        </div>

        <div class="modify-user-div">
          <h3 class="modify-user-title">Worth Points</h3>
          <input
            id="modify-user-worth-points"
            class="input-text"
            type="number"
          />
        </div>

        <div class="modify-user-div">
          <h3 class="modify-user-title">Worth Points Comment</h3>
          <input
            id="modify-user-worth-points-comment"
            class="input-text"
            type="text"
          />
        </div>
        <div class="flex flex-row gap-2 items-stretch">
          <button
            id="modify-user-btn"
            class="btn btn-alternate-blue font-bold flex-1"
          >
            Save Changes
          </button>
          <button
            id="delete-user-btn"
            class="btn btn-alternate font-bold flex-1"
          >
            Delete User
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Column -->
  <div class="card-column">
    <!-- Card -->
    <div class="card-padded">
      <h2 class="item-title">Leaderboard</h2>
      <div class="card-contents">
        <div class="flex flex-row gap-2 items-stretch">
          <button
            id="leaderboard-by-points-btn"
            class="btn btn-alternate-tan flex-1 btn-selected"
          >
            By Points
          </button>
          <button
            id="leaderboard-by-users-btn"
            class="btn btn-alternate-tan flex-1"
          >
            By Users Met
          </button>
        </div>

        <div id="leaderboard-by-points" class="">
          <p class="italic">Loading leaderboard...</p>
        </div>
        <div id="leaderboard-by-users" class="hidden">
          <p class="italic">Loading leaderboard...</p>
        </div>
      </div>
    </div>

    <!-- Card -->
    <div class="card-padded">
      <h2 class="item-title">Database</h2>
      <div class="card-contents">
        <button id="database-export" class="btn btn-alternate flex-1">
          Export Game
        </button>
        <button id="database-import" class="btn btn-alternate flex-1">
          Import Game
        </button>
        <button id="database-wipe" class="btn btn-primary flex-1">
          Wipe Game
        </button>
      </div>
    </div>
  </div>
</div>
<!-- Toast Notifications Container -->
<div id="toast-container" class="toast-container">
  <!-- Toasts will be injected here by JS -->
</div>
