---
title: Notifications
layout: base.njk
---

<script type="module">
  import {
    getFirestore,
    collection,
    addDoc,
    query,
    where,
    getDocs,
    deleteDoc, // <-- Added deleteDoc
    doc, // <-- Added doc
  } from "firebase/firestore"
  import {
    getStorage,
    ref,
    uploadBytes,
    getDownloadURL,
  } from "firebase/storage"

  document.addEventListener("DOMContentLoaded", () => {
    const db = getFirestore()
    const storage = getStorage()

    const scheduleCheck = document.getElementById("notif-schedule-check")
    const scheduleContainer = document.getElementById("schedule-container")
    const submitBtn = document.getElementById("notif-submit-btn")
    const form = document.getElementById("notification-form")
    const scheduledTbody = document.getElementById("scheduled-table-body")
    const sentTbody = document.getElementById("sent-table-body")
    const failedTbody = document.getElementById("failed-table-body")

    // Toast Functionality
    function showToast(message) {
      const container = document.getElementById("toast-container")
      if (!container) return

      const toast = document.createElement("div")
      toast.className = "toast-message opacity-0"
      toast.innerText = message

      container.appendChild(toast)

      setTimeout(() => {
        toast.classList.remove("opacity-0")
        toast.classList.add("opacity-100")
      }, 10)

      setTimeout(() => {
        toast.classList.remove("opacity-100")
        toast.classList.add("opacity-0")
        setTimeout(() => toast.remove(), 300)
      }, 3000)
    }

    // Helper to format ISO strings into local date and time consistently
    function getLocalDisplay(isoString) {
      if (!isoString) return { date: "N/A", time: "N/A" }
      const dateObj = new Date(isoString)
      const day = String(dateObj.getDate()).padStart(2, "0")
      const month = String(dateObj.getMonth() + 1).padStart(2, "0")
      const year = dateObj.getFullYear()
      const hours = String(dateObj.getHours()).padStart(2, "0")
      const minutes = String(dateObj.getMinutes()).padStart(2, "0")
      return {
        date: `${month}/${day}/${year}`,
        time: `${hours}:${minutes}`,
      }
    }

    // Master Refresh Function
    async function refresh() {
      try {
        // Fetch and render Scheduled Items (status == "pending")
        const qScheduled = query(
          collection(db, "notifications"),
          where("status", "==", "pending")
        )
        const scheduledSnap = await getDocs(qScheduled)

        let pendingNotifications = []
        scheduledSnap.forEach((docSnap) => {
          const data = docSnap.data()
          if (data.sendAt > new Date().toISOString()) {
            // Include document ID so we can delete it later
            pendingNotifications.push({ id: docSnap.id, ...data })
          }
        })

        // Sort chronologically
        pendingNotifications.sort(
          (a, b) => new Date(a.sendAt) - new Date(b.sendAt)
        )

        scheduledTbody.innerHTML = ""
        pendingNotifications.forEach((data) => {
          const local = getLocalDisplay(data.sendAt)

          // Added delete button in the last column
          scheduledTbody.innerHTML += `
          <tr class="border-b border-scouting-light-tan">
            <td class="py-2 pr-2 font-bold">${data.title}</td>
            <td class="py-2 pr-2 truncate max-w-xs">${data.text}</td>
            <td class="py-2 pr-2 font-bold text-scouting-blue text-xs">${data.topic}</td>
            <td class="py-2 pr-2">${local.date}</td>
            <td class="py-2 pr-2">${local.time}</td>
            <td class="py-2 pr-2">
              <button class="btn btn-primary delete-scheduled-btn text-xs py-1 px-2" data-id="${data.id}">Delete</button>
            </td>
          </tr>
        `
        })

        // Fetch and render Sent Items (status == "sent")
        const qSent = query(
          collection(db, "notifications"),
          where("status", "==", "sent")
        )
        const sentSnap = await getDocs(qSent)

        let sentNotifications = []
        sentSnap.forEach((docSnap) => {
          sentNotifications.push(docSnap.data())
        })

        // Sort sent notifications descending by send date
        sentNotifications.sort(
          (a, b) => new Date(b.sendAt) - new Date(a.sendAt)
        )

        sentTbody.innerHTML = ""
        sentNotifications.forEach((data) => {
          const local = getLocalDisplay(data.sendAt)

          sentTbody.innerHTML += `
          <tr class="border-b border-scouting-light-tan">
            <td class="py-2 pr-2 font-bold">${data.title}</td>
            <td class="py-2 pr-2 truncate max-w-xs">${data.text}</td>
            <td class="py-2 pr-2 font-bold text-scouting-blue text-xs">${
              data.topic
            }</td>
            <td class="py-2 pr-2">${local.date}</td>
            <td class="py-2 pr-2">${local.time}</td>
            <td class="py-2 pr-2 text-center">${data.openedCount || 0}</td>
          </tr>
        `
        })

        // Fetch and render Failed Items (status == "failed")
        const qFailed = query(
          collection(db, "notifications"),
          where("status", "==", "failed")
        )
        const failedSnap = await getDocs(qFailed)

        let failedNotifications = []
        failedSnap.forEach((docSnap) => {
          failedNotifications.push(docSnap.data())
        })

        // Sort failed notifications descending by send date
        failedNotifications.sort(
          (a, b) => new Date(b.sendAt) - new Date(a.sendAt)
        )

        failedTbody.innerHTML = ""
        failedNotifications.forEach((data) => {
          const local = getLocalDisplay(data.sendAt)

          failedTbody.innerHTML += `
          <tr class="border-b border-scouting-light-tan bg-red-50">
            <td class="py-2 pr-2 font-bold">${data.title}</td>
            <td class="py-2 pr-2 truncate max-w-xs">${data.text}</td>
            <td class="py-2 pr-2 font-bold text-scouting-blue text-xs">${
              data.topic
            }</td>
            <td class="py-2 pr-2">${local.date}</td>
            <td class="py-2 pr-2">${local.time}</td>
            <td class="py-2 pr-2 text-red-600 text-xs">${
              data.error || "Unknown Error"
            }</td>
          </tr>
        `
        })
      } catch (error) {
        console.error("Error refreshing tables: ", error)
        showToast(
          "Error refreshing tables. Are you logged in with an authorized account?"
        )
      }
    }

    // Attach master refresh event to all refresh icons
    document.querySelectorAll(".refresh-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        refresh()
        showToast("Refreshing Database...")
      })
    })

    // Initial load
    refresh()

    // Handle Deletion of Scheduled Notifications
    scheduledTbody.addEventListener("click", async (e) => {
      // Check if the clicked element is our delete button
      if (e.target.classList.contains("delete-scheduled-btn")) {
        const docId = e.target.getAttribute("data-id")

        if (
          confirm(
            "Are you sure you want to delete this scheduled notification?"
          )
        ) {
          e.target.disabled = true
          e.target.textContent = "Deleting..."

          try {
            await deleteDoc(doc(db, "notifications", docId))
            showToast("Notification deleted.")
            refresh() // Refresh to remove the row from UI
          } catch (error) {
            console.error("Error deleting notification: ", error)
            showToast("Error deleting notification.")
            e.target.disabled = false
            e.target.textContent = "Delete"
          }
        }
      }
    })

    // Toggle schedule visibility and requirement constraints
    scheduleCheck.addEventListener("change", (e) => {
      if (e.target.checked) {
        scheduleContainer.classList.remove("hidden")
        scheduleContainer.classList.add("flex")
        submitBtn.textContent = "Schedule Notification"
        document.getElementById("notif-date").setAttribute("required", "true")
        document.getElementById("notif-time").setAttribute("required", "true")
      } else {
        scheduleContainer.classList.remove("flex")
        scheduleContainer.classList.add("hidden")
        submitBtn.textContent = "Send Notification"
        document.getElementById("notif-date").removeAttribute("required")
        document.getElementById("notif-time").removeAttribute("required")
      }
    })

    form.addEventListener("submit", async (e) => {
      e.preventDefault()

      submitBtn.disabled = true
      submitBtn.textContent = "Processing..."

      const isScheduled = scheduleCheck.checked

      const localFormatterDate = new Intl.DateTimeFormat("en-US", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      })
      const localFormatterTime = new Intl.DateTimeFormat("en-US", {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      })

      try {
        const imageInput = document.getElementById("notif-image")
        let imageUrl = null

        if (imageInput.files && imageInput.files[0]) {
          const file = imageInput.files[0]
          const storageRef = ref(
            storage,
            `notification_images/${Date.now()}_${file.name}`
          )
          const snapshot = await uploadBytes(storageRef, file)
          imageUrl = await getDownloadURL(snapshot.ref)
        }

        let sendAtISO
        if (isScheduled) {
          const d = document.getElementById("notif-date").value
          const t = document.getElementById("notif-time").value
          sendAtISO = new Date(`${d}T${t}`).toISOString()
        } else {
          sendAtISO = new Date().toISOString()
        }

        const notificationData = {
          title: document.getElementById("notif-title").value,
          text: document.getElementById("notif-text").value,
          imageUrl: imageUrl,
          topic: document.getElementById("notif-topic").value,
          sendAt: sendAtISO,
          date: isScheduled
            ? document.getElementById("notif-date").value
            : localFormatterDate.format(new Date()),
          time: isScheduled
            ? document.getElementById("notif-time").value
            : localFormatterTime.format(new Date()),
          openedCount: 0,
          status: "pending",
          createdAt: new Date().toISOString(),
        }

        await addDoc(collection(db, "notifications"), notificationData)

        form.reset()
        scheduleContainer.classList.remove("flex")
        scheduleContainer.classList.add("hidden")
        submitBtn.textContent = "Send Notification"

        showToast(
          isScheduled
            ? "Notification scheduled successfully!"
            : "Notification sent successfully!"
        )

        // Auto-refresh the tables immediately after saving
        await refresh()
      } catch (error) {
        console.error("Error managing notification: ", error)
        showToast("Error processing notification.")
      } finally {
        submitBtn.disabled = false
        if (scheduleContainer.classList.contains("hidden")) {
          submitBtn.textContent = "Send Notification"
        } else {
          submitBtn.textContent = "Schedule Notification"
        }
      }
    })
  })
</script>

<div>
  <!-- Send a Notification -->
  <div class="card-padded">
    <h2 class="item-title">Send a Notification</h2>
    <form id="notification-form" class="card-contents">
      <input
        type="text"
        id="notif-title"
        class="input-text"
        placeholder="Notification Title"
        required
      />
      <textarea
        id="notif-text"
        class="input-text"
        placeholder="Notification Text"
        rows="3"
        required
      ></textarea>

      <label class="text-sm font-bold text-scouting-dark-grey mt-2 mb-1"
        >Target Audience (Topic)</label
      >
      <select id="notif-topic" class="input-text mb-2 bg-white" required>
        <option value="all_users">all_users</option>
      </select>
      <label class="text-sm font-bold text-scouting-dark-grey mt-2 mb-1"
        >Image Upload (Optional)</label
      >
      <input
        type="file"
        id="notif-image"
        accept="image/*"
        class="block w-full text-sm text-scouting-dark-grey border border-scouting-pale-grey rounded-md cursor-pointer bg-white focus:outline-none focus:ring-1 focus:ring-scouting-blue file:mr-4 file:py-2 file:px-4 file:border-0 file:text-sm file:font-bold file:bg-scouting-blue file:text-white hover:file:brightness-90 transition-all"
      />

      <label
        class="flex items-center gap-2 font-bold text-scouting-dark-grey text-sm mt-2 cursor-pointer"
      >
        <input type="checkbox" id="notif-schedule-check" />
        Schedule Send
      </label>

      <div
        id="schedule-container"
        class="hidden flex-col gap-3 p-4 bg-scouting-light-tan rounded-md"
      >
        <!-- Updated Label -->
        <p class="text-sm font-bold text-scouting-dark-grey mb-1">
          Set Target (Local Time)
        </p>
        <input type="date" id="notif-date" class="input-text" />
        <input type="time" id="notif-time" class="input-text" />
      </div>

      <button type="submit" id="notif-submit-btn" class="btn btn-primary mt-2">
        Send Notification
      </button>
    </form>
  </div>

  <!-- Scheduled Notifications -->
  <div class="card-padded">
    <div class="flex items-center justify-between mb-4">
      <h2 class="item-title m-0">Scheduled Notifications</h2>
      <button class="refresh-btn" title="Refresh Database">
        <i class="fas fa-sync-alt"></i>
      </button>
    </div>
    <div class="card-contents overflow-x-auto">
      <table
        class="w-full text-left border-collapse text-sm text-scouting-dark-grey"
      >
        <thead>
          <tr class="border-b border-scouting-light-grey">
            <th class="py-2">Title</th>
            <th class="py-2">Text</th>
            <th class="py-2">Topic</th>
            <th class="py-2">Send Date</th>
            <th class="py-2">Send Time</th>
            <th class="py-2">Delete</th>
          </tr>
        </thead>
        <tbody id="scheduled-table-body">
          <!-- Populated by JS -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- Prior Notifications -->
  <div class="card-padded">
    <div class="flex items-center justify-between mb-4">
      <h2 class="item-title m-0">Prior Notifications</h2>
      <button class="refresh-btn" title="Refresh Database">
        <i class="fas fa-sync-alt"></i>
      </button>
    </div>
    <div class="card-contents overflow-x-auto">
      <table
        class="w-full text-left border-collapse text-sm text-scouting-dark-grey"
      >
        <thead>
          <tr class="border-b border-scouting-light-grey">
            <th class="py-2">Title</th>
            <th class="py-2">Text</th>
            <th class="py-2">Topic</th>
            <th class="py-2">Send Date</th>
            <th class="py-2">Send Time</th>
            <th class="py-2 text-center">Number Opened</th>
          </tr>
        </thead>
        <tbody id="sent-table-body">
          <!-- Populated by JS -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- Failed Notifications -->
  <div class="card-padded">
    <div class="flex items-center justify-between mb-4">
      <h2 class="item-title m-0">Failed Notifications</h2>
      <button class="refresh-btn" title="Refresh Database">
        <i class="fas fa-sync-alt"></i>
      </button>
    </div>
    <div class="card-contents overflow-x-auto">
      <table
        class="w-full text-left border-collapse text-sm text-scouting-dark-grey"
      >
        <thead>
          <tr class="border-b border-scouting-light-grey">
            <th class="py-2">Title</th>
            <th class="py-2">Text</th>
            <th class="py-2">Topic</th>
            <th class="py-2">Send Date</th>
            <th class="py-2">Send Time</th>
            <th class="py-2 text-red-600">Error</th>
          </tr>
        </thead>
        <tbody id="failed-table-body">
          <!-- Populated by JS -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- Toast Notifications Container -->
  <div id="toast-container" class="toast-container">
    <!-- Toasts will be injected here by JS -->
  </div>
</div>
